# ====================================================================
# SmartParking — FICHIER D'EXEMPLE DE CONFIGURATION
# ====================================================================
#
#  COMMENT UTILISER CE FICHIER
#  ----------------------------
#  1. Copiez-le en .env  :   cp .env.example .env   (ou copiez-colliez)
#  2. Modifiez les valeurs.
#  3. Le vrai .env n'est JAMAIS versionné par Git : il contient votre
#     mot de passe PostgreSQL et votre clé de signature des tokens.
#
#  Ce fichier-ci, lui, EST versionné : il sert de modèle à vos
#  camarades et à votre correcteur.
#
#  Toutes les variables ci-dessous sont réellement lues par le code.
#  Chaque ligne indique le fichier qui la consomme.
# ====================================================================


# -------------------------------------------------------------------
# SERVEUR                                    (server.js)
# -------------------------------------------------------------------
# Port d'écoute de l'API. 3000 par défaut.
PORT=3000

# 'development' ou 'production'.
# En 'production', les erreurs détaillées ne sont plus renvoyées au
# client et les liens de vérification ne sont plus inclus dans les
# réponses JSON (ils ne le sont qu'en développement).
NODE_ENV=development


# -------------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL                  (config/db.js,
#                                               database/init-db.js)
# -------------------------------------------------------------------
# Hôte PostgreSQL. Si votre base tourne dans WSL comme ici,
# 'localhost' fonctionne grâce au relais de port.
DB_HOST=localhost
DB_PORT=5432

# Utilisateur et mot de passe PostgreSQL.
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_ici

# Nom de la base. Elle doit exister :
#   npm run init-db     (la crée si besoin et applique schema.sql)
DB_NAME=smartparking


# -------------------------------------------------------------------
# TOKENS JWT                                  (config/jwt.config.js)
# -------------------------------------------------------------------
# Clé de SIGNATURE des tokens. C'est le secret le plus important du
# projet : quiconque le possède peut fabriquer un jeton administrateur.
#
#   Générez la vôtre avec la commande suivante :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Ne JAMAIS réutiliser la valeur d'un exemple ni d'un autre projet.
JWT_SECRET=collez_ici_la_cle_generee_par_la_commande_ci_dessus

# Durée de validité d'une session. 72h = 3 jours.
JWT_EXPIRES_IN=72h


# -------------------------------------------------------------------
# ENVOI D'EMAILS                              (services/email.service.js)
# -------------------------------------------------------------------
# Adresse du front, utilisée pour construire les liens des emails.
# Doit correspondre à l'adresse où l'application tourne réellement.
FRONTEND_URL=http://localhost:4200

# Nom et adresse d'expéditeur affichés dans le mail.
EMAIL_EXPEDITEUR=SmartParking <no-reply@smartparking.local>


# -------------------------------------------------------------------
# SMTP — OPTIONNEL                            (services/email.service.js)
# -------------------------------------------------------------------
#
#  MODE DÉVELOPPEMENT (par défaut, aucun réglage à faire)
#  ---------------------------------------------------
#  Laissez SMTP_HOST VIDE. Le serveur n'envoie aucun vrai email :
#  il écrit le contenu de chaque message dans le dossier
#      backend/emails/
#  et affiche le lien de vérification dans la console.
#  C'est ce mode qui est utilisé pour ce projet étudiant.
#
#  MODE RÉEL (pour un vrai déploiement)
#  -----------------------------------
#  Renseignez les 5 lignes ci-dessous.
#
#  Exemple Gmail :
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=votre.adresse@gmail.com
#    SMTP_PASS=<mot de passe d'application Google>
#
#  ⚠ Gmail refuse le mot de passe du compte lui-même. Il faut créer un
#    « mot de passe d'application » depuis les paramètres de sécurité
#    du compte Google.
#
#  Exemple Outlook / Microsoft 365 :
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=votre.adresse@outlook.com
#    SMTP_PASS=votre_mot_de_passe
#
# -------------------------------------------------------------------

# Laissez VIDE pour le mode développement.
SMTP_HOST=
SMTP_PORT=587

# 'true' pour le port 465 (connexion chiffrée directe),
# 'false' pour le port 587 (STARTTLS).
SMTP_SECURE=false

# Ignorés si SMTP_HOST est vide.
SMTP_USER=
SMTP_PASS=